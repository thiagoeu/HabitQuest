{
  "expo": {
    "name": "HabitQuest",
    "slug": "mvp-gamified-habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "habitquest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e1e2d"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1"
        }
      ]
    ]
  }
}
